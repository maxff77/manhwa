{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/pedro/.agents/skills/impeccable/scripts/impeccable' ] || '/Users/pedro/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "cmd /c if exist \"\\Users\\pedro\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" \"\\Users\\pedro\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.npm/_npx/f403495c3e985d95/node_modules/@reticlehq/server/bin/reticle.js\" hook tool --agent codex || npx -y @reticlehq/server@3.10.6 hook tool --agent codex",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/pedro/.agents/skills/impeccable/scripts/impeccable' ] || '/Users/pedro/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "cmd /c if exist \"\\Users\\pedro\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" \"\\Users\\pedro\\.agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.npm/_npx/f403495c3e985d95/node_modules/@reticlehq/server/bin/reticle.js\" hook tool --agent codex || npx -y @reticlehq/server@3.10.6 hook tool --agent codex",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.npm/_npx/f403495c3e985d95/node_modules/@reticlehq/server/bin/reticle.js\" hook prompt --agent codex || npx -y @reticlehq/server@3.10.6 hook prompt --agent codex",
            "timeout": 30
