// Modelo de datos del dominio — issue #2.
// Nombres de modelos/campos en inglés; el lenguaje del dominio (GLOSSARY.md) en español.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeriesStatus {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
}

enum SeriesType {
  MANHWA
  MANGA
  MANHUA
  OTHER
}

enum PageStatus {
  PENDING
  READY
  ERROR
}

enum UserRole {
  USER
  MODERATOR
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CommentReportReason {
  SPAM
  ABUSE
  OTHER
}

enum CommentReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  REPLY
  MENTION
}

/// Fuente externa: olympus (contenido), mangadex (metadata).
model Source {
  id       String         @id @default(cuid())
  slug     String         @unique
  name     String
  series   SeriesSource[]
  chapters Chapter[]

  @@map("sources")
}

/// Obra interna, independiente de la Fuente de la que se obtiene.
model Series {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  originalTitle  String?
  synopsis       String?
  coverKey       String?
  coverSourceUrl String?
  status         SeriesStatus
  type           SeriesType
  demographic    String?
  erotic         Boolean      @default(false)
  genres         String[]
  authors        String[]
  year           Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sources     SeriesSource[]
  chapters    Chapter[]
  follows     Follow[]
  progress    Progress[]
  collections CollectionSeries[]
  comments    Comment[]

  @@map("series")
}

/// Vínculo de una Serie con su identidad en una Fuente.
model SeriesSource {
  id                  String   @id @default(cuid())
  seriesId            String
  sourceId            String
  externalId          String
  url                 String?
  createdAt           DateTime @default(now())
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime?
  consecutiveFailures Int      @default(0)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalId])
  @@index([seriesId])
  @@index([nextCheckAt])
  @@map("series_sources")
}

/// Capítulo de una Serie tal como lo expone una Fuente de contenido.
model Chapter {
  id          String   @id @default(cuid())
  seriesId    String
  sourceId    String
  externalId  String
  number      Float
  title       String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  series   Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  source   Source     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pages    Page[]
  progress Progress[]
  comments Comment[]

  @@unique([sourceId, externalId])
  @@unique([seriesId, sourceId, number])
  @@index([seriesId, number])
  @@map("chapters")
}

/// Imagen de un Capítulo y su estado de caché en R2.
model Page {
  id         String     @id @default(cuid())
  chapterId  String
  position   Int
  sourceUrl  String
  r2Key      String?
  status     PageStatus @default(PENDING)
  mimeType   String?
  bytes      Int?
  updatedAt  DateTime   @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, position])
  @@map("pages")
}

/// Usuario de la plataforma. Better Auth es dueño de credenciales y sesiones (#7).
model User {
  id                    String   @id
  name                  String
  email                 String   @unique
  emailVerified         Boolean  @default(false)
  image                 String?
  username              String?  @unique
  role                  UserRole @default(USER)
  commentsBlockedAt     DateTime?
  commentsBlockedReason String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  follows            Follow[]
  progress           Progress[]
  collections        Collection[]
  pushSubscriptions  PushSubscription[]
  comments           Comment[]          @relation("CommentAuthor")
  moderatedComments  Comment[]          @relation("CommentModerator")
  deletedComments    Comment[]          @relation("CommentDeleter")
  commentReactions   CommentReaction[]
  commentReports     CommentReport[]    @relation("ReportReporter")
  resolvedReports    CommentReport[]    @relation("ReportResolver")
  notifications      Notification[]     @relation("NotificationRecipient")
  actedNotifications Notification[]     @relation("NotificationActor")

  @@map("users")
}

/// Sesión iniciada. Token opaco generado por Better Auth.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

/// Identidad de un proveedor ligada a un Usuario: credenciales, Google o Discord.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Tokens de un solo uso: reset de contraseña y estado OAuth.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Ventana de rate limiting persistida (storage "database" de Better Auth).
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rate_limits")
}

/// Serie que un Usuario sigue explícitamente. Alimenta su Biblioteca y las alertas.
model Follow {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  alerts    Boolean  @default(true)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([seriesId])
  @@map("follows")
}

/// Suscripción Web Push de un dispositivo. El endpoint lo genera el navegador y es único.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failures      Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Lista con nombre curada por un Usuario. No implica seguir sus Series.
model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  series CollectionSeries[]

  @@unique([userId, name])
  @@map("collections")
}

model CollectionSeries {
  collectionId String
  seriesId     String
  position     Int
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  series     Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([collectionId, seriesId])
  @@unique([collectionId, position])
  @@index([seriesId])
  @@map("collection_series")
}

/// Último punto de lectura de un Usuario en una Serie. Último leído gana.
model Progress {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  chapterId String
  page      Int
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([seriesId])
  @@index([chapterId])
  @@map("progress")
}

/// Comentario en el hilo de una Serie (chapterId null) o de un Capítulo.
/// Las Respuestas cuelgan de parentId sin límite de profundidad.
model Comment {
  id        String        @id @default(cuid())
  authorId  String?
  seriesId  String
  chapterId String?
  parentId  String?
  body      String
  status    CommentStatus @default(VISIBLE)
  likeCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  moderatedById String?
  moderatedAt   DateTime?
  deletedById   String?
  deletedAt     DateTime?

  author    User?    @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  moderator User?    @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  deleter   User?    @relation("CommentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  reactions     CommentReaction[]
  reports       CommentReport[]
  notifications Notification[]

  @@index([chapterId, parentId, status, createdAt, id])
  @@index([seriesId, parentId, status, createdAt, id])
  @@index([parentId, createdAt, id])
  @@index([authorId, createdAt])
  @@map("comments")
}

/// «Me gusta» de un Usuario a un Comentario. Uno por Usuario y Comentario.
model CommentReaction {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_reactions")
}

/// Reporte de un Usuario sobre un Comentario.
model CommentReport {
  id           String              @id @default(cuid())
  commentId    String
  reporterId   String?
  reason       CommentReportReason
  note         String?
  status       CommentReportStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([status, createdAt])
  @@index([commentId])
  @@map("comment_reports")
}

/// Aviso in-app de una Respuesta o Mención.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  commentId String
  type      NotificationType
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId, type])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
