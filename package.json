    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@reticlehq/next": "3.10.6",
    "@reticlehq/react": "3.10.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
