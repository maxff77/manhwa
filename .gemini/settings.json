{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "impeccable-session",
            "type": "command",
            "command": "[ ! -f '/Users/pedro/.gemini/skills/impeccable/scripts/impeccable' ] || '/Users/pedro/.gemini/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "impeccable-completion",
            "type": "command",
            "command": "[ ! -f '/Users/pedro/.gemini/skills/impeccable/scripts/impeccable' ] || '/Users/pedro/.gemini/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.npm/_npx/f403495c3e985d95/node_modules/@reticlehq/server/bin/reticle.js\" hook tool --agent gemini || npx -y @reticlehq/server@3.10.6 hook tool --agent gemini"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.npm/_npx/f403495c3e985d95/node_modules/@reticlehq/server/bin/reticle.js\" hook prompt --agent gemini || npx -y @reticlehq/server@3.10.6 hook prompt --agent gemini"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.npm/_npx/f403495c3e985d95/node_modules/@reticlehq/server/bin/reticle.js\" hook tool --agent gemini || npx -y @reticlehq/server@3.10.6 hook tool --agent gemini"
          }
        ]
      }
    ]
  }
}
